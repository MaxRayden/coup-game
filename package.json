{
  "name": "coup-controle-partida",
  "version": "2.0.0",
  "private": true,
  "description": "Controle visual de partida Coup — moedas e cartas, com servidor na rede local",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-dev.ps1",
    "dev": "npm run stop && concurrently -n server,client -c gold,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch --env-file=.env.development server/index.ts",
    "dev:client": "wait-on tcp:127.0.0.1:7001 && vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "start": "tsx server/index.ts",
    "start:local": "npm run stop && npm start",
    "preview": "npm run build && npm run start:local",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react-router-dom": "^7.18.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.0.0",
    "wait-on": "^8.0.3"
  }
}
