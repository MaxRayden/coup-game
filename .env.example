# Copie para .env.development (dev) ou .env (produção local).
# Em plataformas de deploy (Render, Railway, Docker), use apenas PORT.

# --- Desenvolvimento (npm run dev) ---
# Ativa modo split: API na PORT, Vite na 7000 (ver config/ports.ts)
COUP_DEV=1
PORT=7001

# --- Produção (npm run build && npm start) ---
# COUP_DEV não deve ser 1 — interface + API na mesma porta
# PORT=7000
# NODE_ENV=production
